# Set a long, random value before deployment to keep sessions valid across restarts.
SECRET_KEY=replace-with-a-long-random-secret

# Use production for hosted deployment. Production requires SECRET_KEY,
# enables secure cookies, and disables the seeded demo users.
APP_ENV=development
DEMO_USERS_ENABLED=true

# Optional: defaults to instance/campus.db. On Render, use a persistent disk path,
# for example /var/data/campus.db.
DATABASE_PATH=instance/campus.db

# Local HTTP default is false. Production always enables secure cookies.
SESSION_COOKIE_SECURE=false

# Optional local development settings. Gunicorn reads its bind/port from its CLI.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
